rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.xp is int &&
             data.level is int &&
             data.streak is int &&
             data.lastActive is int &&
             (!('email' in data) || (data.email is string && data.email.size() <= 200));
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data)
                    // Anti-tamper (TODO-003): XP is monotonic — a client may
                    // never lower it (blocks score-reset griefing on stolen
                    // sessions) — and is bounded to a sane ceiling.
                    && request.resource.data.xp >= resource.data.xp
                    && request.resource.data.xp <= 10000000;
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // Public leaderboard (TODO-003): one entry per user, readable by any
    // signed-in user, writable ONLY by its owner, and the published XP must
    // exactly mirror the owner's own profile document — there is no second
    // place to invent a score. Full anti-cheat would require server-authored
    // writes (Cloud Functions); documented limitation.
    match /leaderboard/{userId} {
      allow get, list: if isSignedIn();
      allow write: if isOwner(userId)
                   && isValidId(userId)
                   && request.resource.data.name is string
                   && request.resource.data.name.size() > 0
                   && request.resource.data.name.size() <= 50
                   && request.resource.data.avatar is string
                   && request.resource.data.avatar.size() <= 20
                   && request.resource.data.xp is int
                   && request.resource.data.xp >= 0
                   && request.resource.data.xp == get(/databases/$(database)/documents/users/$(userId)).data.xp;
      allow delete: if isOwner(userId);
    }
  }
}
