# ---------------------------------------------------------------------------
# Kurdish Quest — environment configuration
#
# Copy to `.env` and fill in. `.env*` is git-ignored (except this example).
# ---------------------------------------------------------------------------

# GEMINI_API_KEY: Required for Gemini AI API calls.
# NOTE: vite.config.ts injects this via `define`, which INLINES the value into
# the client bundle. Never put a privileged key here — anything defined this way
# is publicly readable by any user. Move Gemini calls behind server.ts before
# using a billable key.
GEMINI_API_KEY=""

# APP_URL: The public origin this app is served from.
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# TTS Configuration
# ---------------------------------------------------------------------------
# TTS_PROVIDER can be 'google' (default) or 'kurdishtts'
TTS_PROVIDER=google
KURDISHTTS_API_KEY=""
KURDISHTTS_MODEL_VERSION="v4"
KURDISHTTS_SPEAKER_ID="kurmanji_236"

# ---------------------------------------------------------------------------
# Firebase (REAL project configuration — TODO-002)
# ---------------------------------------------------------------------------
# When ALL four core values below are set at build time, the app treats the
# cloud as configured: Google sign-in and sync affordances appear, and the
# committed dev placeholder (firebase-applet-config.json) is ignored.
# Firebase web config values are not secrets (they ship in the client bundle
# by design) — data protection is enforced by firestore.rules. Still, keep
# real project values out of the repo: inject them via deployment env.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
# Optional:
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
